        def text(self):
            return self.buffer.get_text(self.buffer.get_start_iter(),self.buffer.get_end_iter(),True)

        def draft_path(self):
            return self.recovery/(hashlib.sha256(str(self.path).encode()).hexdigest()+'.txt')

        def keep_draft(self):
            self.recovery.mkdir(parents=True,exist_ok=True,mode=0o700)
            path=self.draft_path();tmp=path.with_suffix('.tmp-'+str(os.getpid()))
            tmp.write_text(self.text());tmp.chmod(0o600);os.replace(tmp,path)

        def save(self):
            if self.timer: GLib.source_remove(self.timer);self.timer=None
            if not self.dirty or self.path is None:return True
            try:
                self.keep_draft()
                self.etag=self.store.save(self.path,self.text(),self.etag)
                self.dirty=False
                for i,(path,_) in enumerate(self.entries):
                    if path==self.path:self.entries[i]=(path,self.text().casefold());break
                self.draft_path().unlink(missing_ok=True)
                self.status.set_text('Saved · '+str(self.path.relative_to(root)))
                return True
            except (OSError,ValueError,GLib.Error) as exc:
                self.status.set_text('Not saved: '+str(exc)+' · Ctrl+Shift+s saves your edits as a new note.')
                return False

        def changed(self,*_):
            if self.loading or self.path is None:return
            self.dirty=True;self.status.set_text('Editing · unsaved changes')
            if self.timer:GLib.source_remove(self.timer)
            def autosave():self.timer=None;self.save();return False
            self.timer=GLib.timeout_add(options['autosave_delay_ms'],autosave) if options['autosave'] else None

        def close(self,*_):
            if not self.save():return True
            if self.poll:GLib.source_remove(self.poll);self.poll=None
            return False

        def focus_list(self):
            self.mode='list';self.editor.set_editable(False);self.list.grab_focus()
            self.guide.set_text('j/k notes · h/l list/preview · i edit · n new · p paste new · a append · y copy · / search · gg/G · N folder · Ctrl+s save · Esc/q close · ? keys')

        def preview_mode(self):
            self.mode='preview';self.editor.set_editable(False);self.editor.grab_focus()
            self.guide.set_text('h/j/k/l move · gg/G start/end · Ctrl+u/d page · i edit · h at start or Ctrl+Enter: note list · Esc close · y copy · Ctrl+s save')

        def edit(self):
            if self.path is None:return
            self.mode='edit';self.editor.set_editable(True);self.editor.grab_focus()
            self.guide.set_text('EDIT · type normally · Ctrl+z undo · Ctrl+Shift+z redo · Ctrl+s save · Ctrl+Shift+s save copy · Ctrl+Enter: notes · Esc close · '+('autosave after a pause' if options['autosave'] else 'manual save'))

        def refresh(self,focus=None,edit=False):
            if not self.save():return
            self.generation+=1;generation=self.generation
            self.status.set_text('Loading notes…')
            def scan():
                try:entries=self.store.scan();error=None
                except Exception as exc:entries=[];error=str(exc)
                def done():
                    if generation!=self.generation:return False
                    if error:self.status.set_text(error);return False
                    self.entries=entries;self.populate(focus or self.path)
                    if edit:self.edit()
                    if self.path is None:self.status.set_text(f'{len(entries)} notes · {root}')
                    return False
                GLib.idle_add(done)
            threading.Thread(target=scan,daemon=True).start()

        def search_changed(self):
            if not self.save():return
            self.populate(self.path)

        def populate(self,focus=None):
            query=self.search.get_text().casefold()
            self.visible=[p for p,text in self.entries if query in str(p.relative_to(root)).casefold() or (options['search_contents'] and query in text)]
            self.selection_guard=True
            self.model.splice(0,self.model.get_n_items(),[str(p.relative_to(root)) for p in self.visible])
            self.selection.set_selected(self.visible.index(focus) if focus in self.visible else 0)
            self.selection_guard=False;self.selected()

        def selected(self,*_):
            if self.selection_guard:return
            index=self.selection.get_selected();path=self.visible[index] if index<len(self.visible) else None
            if path==self.path:return
            if not self.save():
                self.selection_guard=True
                if self.path in self.visible:self.selection.set_selected(self.visible.index(self.path))
                self.selection_guard=False;return
            if path is None:
                self.path=None;self.loading=True;self.buffer.set_text('');self.loading=False;self.title.set_text(str(root));return
            try:text,etag=self.store.read(path)
            except (OSError,ValueError,GLib.Error) as exc:
                self.status.set_text(str(exc));self.selection_guard=True
                self.selection.set_selected(self.visible.index(self.path) if self.path in self.visible else Gtk.INVALID_LIST_POSITION)
                self.selection_guard=False;return
            self.path=path;self.etag=etag;self.loading=True
            self.buffer.set_enable_undo(False);self.buffer.set_text(text);self.buffer.set_enable_undo(True)
            self.loading=False;self.dirty=False;self.title.set_text(str(path.relative_to(root)))
            self.status.set_text(f'{len(text):,} characters · {path.relative_to(root)}')
            if self.draft_path().is_file():
                self.status.set_text('A recovery draft exists for this note. Press R to recover it as a new note.')

        def move(self,delta=None,end=False):
            if not self.visible:return
            current=self.selection.get_selected()
            if current>=len(self.visible):current=0
            index=(len(self.visible)-1 if end else 0) if delta is None else max(0,min(len(self.visible)-1,current+delta))
            self.selection.set_selected(index)
            self.list.scroll_to(self.selection.get_selected(),Gtk.ListScrollFlags.FOCUS,None)

        def ask_name(self,title,callback,initial=''):
