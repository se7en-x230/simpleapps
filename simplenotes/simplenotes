LIMIT = 2 * 1024 * 1024


DEFAULTS = dict(start_in_search=True, autosave=True, autosave_delay_ms=900, search_contents=True,
                font_size=12, wrap_text=True, window_width=1100, window_height=760,
                sidebar_width=310)


def config_path():
    return Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))/'simplenotes/config.toml'


def settings():
    path = config_path()
    data = tomllib.loads(path.read_text()) if path.exists() else {}
    unknown = data.keys() - (DEFAULTS.keys() | {'notes_dir'})
    if unknown: raise ValueError('Unknown Simplenotes setting: ' + ', '.join(sorted(unknown)))
    result = DEFAULTS | {k:v for k,v in data.items() if k != 'notes_dir'}
    for key in ('start_in_search','autosave','search_contents','wrap_text'):
        if type(result[key]) is not bool: raise ValueError(key+' must be true or false')
    for key, low, high in [('autosave_delay_ms',300,60000),('font_size',8,32),('window_width',640,3000),('window_height',400,2000),('sidebar_width',160,1200)]:
        value=result[key]
        if type(value) is not int or not low <= value <= high: raise ValueError(f'{key} must be an integer from {low} to {high}')
    if result['sidebar_width'] >= result['window_width']-200: raise ValueError('sidebar_width must leave at least 200 pixels for the editor')
    return result


def ensure_config(root):
    path=config_path()
    if path.exists(): return
    path.parent.mkdir(parents=True,exist_ok=True)
    root=Path(root)
    try: location='~/'+str(root.relative_to(Path.home()))
    except ValueError: location=str(root)
    text='# Simplenotes settings. Restart the app after editing.\n# Paths support ~ and environment variables; relative paths use this config folder.\n'
    text+='notes_dir = '+json.dumps(location)+'\n\n'
    comments={'start_in_search':'Focus search immediately when the app opens.',
              'autosave':'Save after a typing pause. Switching notes and closing still save.',
              'autosave_delay_ms':'Typing pause in milliseconds (300–60000).',
              'search_contents':'Search note contents as well as names.',
              'font_size':'Editor text size in points (8–32).',
              'wrap_text':'Wrap long lines in the editor.',
              'window_width':'Initial window width in pixels.',
              'window_height':'Initial window height in pixels.',
              'sidebar_width':'Initial note-list width in pixels.'}
    for key,value in DEFAULTS.items():
        text+='# '+comments[key]+'\n'+key+' = '+json.dumps(value)+'\n\n'
    try:
        with path.open('x') as f: f.write(text)
    except FileExistsError: pass


def configured_root(override=None):
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))
    if override:
        return Path(override).expanduser().absolute(), False
    for app in ('simplenotes', 'notesmanager'):
        path = config/app/'config.toml'
        if path.exists():
            data = tomllib.loads(path.read_text())
            value = data.get('notes_dir')
            if not isinstance(value, str) or not value.strip():
                raise ValueError(f'{path}: notes_dir must be a nonempty string')
            root = Path(os.path.expandvars(value)).expanduser()
            return (root if root.is_absolute() else path.parent/root).absolute(), False
    import gi
    from gi.repository import GLib
    docs = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS)
    return Path(docs or Path.home()/'Documents')/'Notes', True


class Notes:
    def __init__(self, root):
        self.root = Path(root).absolute()

    def checked(self, path):
        path = Path(os.path.abspath(path))
        rel = path.relative_to(self.root)
        cursor = self.root
        for part in rel.parts:
            cursor /= part
            if cursor.is_symlink(): raise ValueError('Symlinks inside the notes folder are not supported')
        if not path.resolve().is_relative_to(self.root.resolve()): raise ValueError('Path is outside the notes folder')
        return path

    def target(self, name, folder=False):
        name = name.strip()
        rel = Path(name)
        if not name or rel.is_absolute() or any(p in ('.', '..') or p.startswith('.') for p in rel.parts) or any(ord(c)<32 for c in name):
            raise ValueError('Use a relative name such as Projects/Ideas.md; hidden names and .. are not allowed')
        if not folder and not rel.suffix: rel = rel.with_suffix('.md')
        return self.checked(self.root/rel)

    def read(self, path):
        from gi.repository import Gio
        path = self.checked(path)
        if not path.is_file() or path.stat().st_size > LIMIT: raise ValueError('Open a text note smaller than 2 MiB')
        ok, content, etag = Gio.File.new_for_path(str(path)).load_contents(None)
        if len(content)>LIMIT: raise ValueError('Note is larger than 2 MiB')
        text = content.decode('utf-8')
        if any(ord(c)<32 and c not in '\n\r\t\f' for c in text): raise ValueError('This file is not a UTF-8 text note')
        return text, etag

    def save(self, path, text, etag):
        from gi.repository import Gio
        path = self.checked(path)
        if not path.is_file(): raise ValueError('This note was moved or deleted outside Simplenotes. Save a copy to keep your edits.')
        if not etag: raise ValueError('This filesystem has no file version token; save a copy to preserve both versions')
        raw = text.encode('utf-8')
        if len(raw)>LIMIT: raise ValueError('Notes must be smaller than 2 MiB')
        ok, new_etag = Gio.File.new_for_path(str(path)).replace_contents(raw, etag, False, Gio.FileCreateFlags.NONE, None)
        return new_etag

    def create(self, name, text=''):
        path = self.target(name)
        if len(text.encode('utf-8'))>LIMIT: raise ValueError('Notes must be smaller than 2 MiB')
        if not path.parent.is_dir(): raise ValueError('Create the folder first with Shift+n')
        with path.open('x', encoding='utf-8') as f: f.write(text)
        return path

    def scan(self):
        from gi.repository import GLib
        entries = []
        def error(exc): raise exc
        for directory, dirs, files in os.walk(self.root, onerror=error):
            dirs[:] = sorted(d for d in dirs if not d.startswith('.') and not (Path(directory)/d).is_symlink())
            for name in sorted(files):
                path = Path(directory)/name
                if name.startswith('.') or path.is_symlink() or not path.is_file(): continue
                mime = mimetypes.guess_type(name)[0] or ''
                if mime.startswith(('image/', 'video/', 'audio/')): continue
                if path.suffix.lower() in ('.pdf','.zip','.gz','.7z','.doc','.docx','.xls','.xlsx','.ods','.odt'): continue
                try: text, _ = self.read(path)
                except (OSError, ValueError, UnicodeError, GLib.Error): continue
                entries.append((path, text.casefold()))
        return sorted(entries, key=lambda item: str(item[0].relative_to(self.root)).casefold())


