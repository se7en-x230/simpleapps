def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--notes-dir')
    parser.add_argument('--check-config', action='store_true')
    args = parser.parse_args(argv)
    try:
        options = settings()
        root, create = configured_root(args.notes_dir)
        if create and not args.check_config: root.mkdir(parents=True, exist_ok=True)
        if not root.is_dir(): raise ValueError(f'Notes folder unavailable: {root}')
    except (OSError, ValueError) as exc:
        print(f'Simplenotes: {exc}', file=sys.stderr); return 1
    if args.check_config:
        print(root); return 0
    # A one-off --notes-dir invocation does not change the persistent location.
    if not args.notes_dir: ensure_config(root)
