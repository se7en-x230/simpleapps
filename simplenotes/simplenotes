        def clipboard_text(self,callback):
            clipboard=Gdk.Display.get_default().get_clipboard()
            def ready(clip,result):
                try:
                    text=clip.read_text_finish(result)
                    if not text:raise ValueError('Clipboard has no text')
                    if len(text.encode('utf-8'))>LIMIT:raise ValueError('Clipboard text exceeds 2 MiB')
                    callback(text)
                except (ValueError,GLib.Error) as exc:self.status.set_text(str(exc))
            clipboard.read_text_async(None,ready)

        def paste_new(self):self.clipboard_text(lambda text:self.new_note(text))

        def append_clipboard(self):
            path=self.path
            if path is None:return
            def append(text):
                if self.path!=path:self.status.set_text('Note changed before clipboard arrived; please try again');return
                current=self.text();separator='' if not current or current.endswith('\n\n') else '\n' if current.endswith('\n') else '\n\n'
                self.buffer.begin_user_action();self.buffer.insert(self.buffer.get_end_iter(),separator+text);self.buffer.end_user_action()
                self.save()
            self.clipboard_text(append)

        def copy(self,file=False):
            if self.path is None:return
            clip=Gdk.Display.get_default().get_clipboard()
            if file:
                value=GLib.Bytes.new((self.path.as_uri()+'\r\n').encode())
                clip.set_content(Gdk.ContentProvider.new_for_bytes('text/uri-list',value))
            else:clip.set(self.text())
            self.status.set_text('Copied file reference' if file else 'Copied note text')

        def recover(self):
            if self.path and self.draft_path().is_file():self.new_note(self.draft_path().read_text(),copy=True)

        def poll_external(self):
            if not self.path or self.dirty:return True
            try:
                info=Gio.File.new_for_path(str(self.path)).query_info('etag::value',Gio.FileQueryInfoFlags.NONE,None)
                if info.get_etag()!=self.etag:
                    path=self.path;self.path=None;self.selected();self.status.set_text('Reloaded external changes · '+path.name)
            except (OSError,GLib.Error):self.status.set_text('Note moved or removed outside Simplenotes · Ctrl+r refreshes the list')
            return True

        def help(self,*_):
            dialog=Gtk.MessageDialog(transient_for=self.win,modal=True,buttons=Gtk.ButtonsType.CLOSE,text='Simplenotes keys',secondary_text='LIST: j/k or arrows select · gg/G first/last · Ctrl+u/d jump · l preview · i/Enter edit · / search · Esc close\n\nNOTES: n new · Shift+n new folder · p new from clipboard · a append clipboard · y copy text · Shift+y copy file reference · Shift+r recover draft · Ctrl+r refresh\n\nEDITOR: i enters text editing; type normally. Ctrl+Enter returns to notes. Esc closes and saves. Ctrl+s save · Ctrl+Shift+s save copy · Ctrl+z undo · Ctrl+Shift+z redo · Ctrl+a/c/v select/copy/paste\n\nPreview uses h/j/k/l to move and gg/G for start/end. Esc closes; q also closes outside text entry. Notes autosave after a short pause. External changes are never silently overwritten.')
            dialog_keys(dialog)
            dialog.connect('response',lambda d,*_:d.destroy());dialog.present()

        def key(self,controller,key,code,state):
            handled = control_key(self.win, key, state)
            if handled is not None:
                if hasattr(self, 'prefix'): self.prefix = ''
                return handled
            ctrl=bool(state&Gdk.ModifierType.CONTROL_MASK);shift=bool(state&Gdk.ModifierType.SHIFT_MASK)
            if state&(Gdk.ModifierType.ALT_MASK|Gdk.ModifierType.SUPER_MASK):return False
            if ctrl and key in (Gdk.KEY_s,Gdk.KEY_S):
                if shift:self.new_note(self.text(),copy=True)
                else:self.save()
                return True
            if key==Gdk.KEY_Escape:
                self.win.close();return True
            if ctrl and key in (Gdk.KEY_Return,Gdk.KEY_KP_Enter):
                if self.save():self.focus_list()
                return True
            # Gtk.Entry's internal Gtk.Text owns focus, so test its ancestors.
            widget=self.win.get_focus()
            while widget:
                if isinstance(widget,Gtk.Entry):return False
                widget=widget.get_parent()
            if self.mode=='edit':return False
            char=chr(Gdk.keyval_to_unicode(key)) if Gdk.keyval_to_unicode(key) else ''
            if ctrl and key==Gdk.KEY_r:self.refresh();return True
            if ctrl and key in (Gdk.KEY_u,Gdk.KEY_d):
                if self.mode=='list':self.move(-10 if key==Gdk.KEY_u else 10)
                else:
                    adjustment=self.editor_scroll.get_vadjustment();adjustment.set_value(adjustment.get_value()+(-1 if key==Gdk.KEY_u else 1)*adjustment.get_page_size()*.8)
                return True
            if ctrl:return False
            if self.prefix:
                self.prefix=''
                if char=='g':
                    if self.mode=='list':self.move()
                    else:self.buffer.place_cursor(self.buffer.get_start_iter());self.editor.scroll_mark_onscreen(self.buffer.get_insert())
                return True
            if char=='g':self.prefix='g';return True
            if char=='G':
                if self.mode=='list':self.move(end=True)
                else:self.buffer.place_cursor(self.buffer.get_end_iter());self.editor.scroll_mark_onscreen(self.buffer.get_insert())
            elif char=='i' or key in (Gdk.KEY_Return,Gdk.KEY_KP_Enter):self.edit()
            elif self.mode=='preview' and char and char in 'hjkl':
                iterator=self.buffer.get_iter_at_mark(self.buffer.get_insert())
                if char=='h' and iterator.is_start():self.focus_list();return True
                {'h':iterator.backward_cursor_position,'l':iterator.forward_cursor_position,'j':iterator.forward_line,'k':iterator.backward_line}[char]()
                self.buffer.place_cursor(iterator);self.editor.scroll_mark_onscreen(self.buffer.get_insert())
            elif key in (Gdk.KEY_j,Gdk.KEY_Down):self.move(1)
            elif key in (Gdk.KEY_k,Gdk.KEY_Up):self.move(-1)
            elif char=='h':self.focus_list()
            elif char=='l':self.preview_mode()
            elif char=='/':self.search.grab_focus()
            elif char=='n':self.new_note()
            elif char=='N':self.new_folder()
            elif char=='p':self.paste_new()
            elif char=='a':self.append_clipboard()
            elif char=='y':self.copy()
            elif char=='Y':self.copy(file=True)
            elif char=='R':self.recover()
            elif char=='?':self.help()
            elif char=='q':self.win.close()
            else:return False
            return True

    return App().run([])

