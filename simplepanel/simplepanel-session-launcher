#!/usr/bin/env python3
"""Start one Simplepanel per session; restart after editing config."""
import shutil,fcntl,os,signal,subprocess,sys,time
from pathlib import Path
binary=Path(shutil.which('simplepanel') or Path(__file__).with_name('simplepanel')).resolve()
runtime=Path(os.environ.get('XDG_RUNTIME_DIR','/run/user/'+str(os.getuid())))
lock=(runtime/'simplepanel-session.lock').open('a')
if sys.argv[1:]==['restart']:
    for proc in Path('/proc').iterdir():
        try:
            if proc.stat().st_uid==os.getuid() and os.readlink(proc/'exe').removesuffix(' (deleted)')==str(binary):
                os.kill(int(proc.name),signal.SIGTERM)
        except (OSError,ValueError):pass
elif sys.argv[1:]:raise SystemExit('Usage: simplepanel-session [restart]')
for attempt in range(30):
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
    except BlockingIOError:
        if not sys.argv[1:]:raise SystemExit(0)
        time.sleep(.1)
else:raise SystemExit('Existing panel did not stop')
os.set_inheritable(lock.fileno(),True)
if sys.argv[1:]==['restart']:
    state=Path(os.environ.get('XDG_STATE_HOME',str(Path.home()/'.local/state')))/'simplepanel'
    state.mkdir(parents=True,exist_ok=True)
    with (state/'panel.log').open('a') as log:
        child=subprocess.Popen([str(binary)],stdin=subprocess.DEVNULL,stdout=log,stderr=log,
                               start_new_session=True,pass_fds=(lock.fileno(),))
    lock.close()
    time.sleep(.3)
    if child.poll() is not None:
        raise SystemExit('Panel failed to start; see '+str(state/'panel.log'))
    print('Simplepanel restarted.')
else:
    os.execv(binary,[str(binary)])
