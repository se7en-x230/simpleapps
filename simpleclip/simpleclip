#!/usr/bin/env python3
"""Standalone clipboard interface using the shared native clipboard module."""
import os
from pathlib import Path
import shutil
import sys

base=Path(__file__).resolve().parent
candidates=[base.parent/'share/simpleclip',base]
assets=next((p for p in candidates if (p/'defaults.json').is_file()),None)
if assets is None:
    raise SystemExit('Simpleclip resources missing; install with ./install --install simpleclip')
config=Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))/'simpleclip'
config.mkdir(parents=True,exist_ok=True)
for name in ('config.toml','keys.ini'):
    target=config/name
    if not target.exists():
        try:
            with target.open('xb') as out:out.write((assets/name).read_bytes())
        except FileExistsError:pass
native=base/'simpleclip-native'
if not native.is_file():raise SystemExit('Simpleclip native binary missing')
env=dict(os.environ,SIMPLEPICKER_ASSETS=str(assets),SIMPLEPICKER_DATA_DIR=str(Path(os.environ.get('XDG_DATA_HOME',Path.home()/'.local/share'))/'simpleclip'))
# The module has its own config/keys; the shared Simple theme still applies.
for name in ('SIMPLEPICKER_CONFIG','SIMPLEPICKER_THEME'):env.pop(name,None)
os.execve(native,[str(native),'--clipboard','--config',str(config/'config.toml'),'--keys',str(config/'keys.ini'),'--theme',str(assets/'style.css'),*sys.argv[1:]],env)
