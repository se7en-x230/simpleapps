#!/bin/sh
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for root in "${SIMPLEWALLPAPER_SOURCE:-}" "$bindir/../share/simplewallpaper" "${XDG_DATA_HOME:-$HOME/.local/share}/simplewallpaper" "$bindir/../src/simplewallpaper"; do
 if [ -n "$root" ] && [ -f "$root/main.py" ]; then exec python3 "$root/main.py" "$@"; fi
done
echo 'Simplewallpaper resources missing' >&2
exit 1
