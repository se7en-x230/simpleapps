#!/usr/bin/env python3
"""One session-local swayidle watcher; reload screensaver settings when edited."""
import fcntl,json,os,shlex,signal,subprocess,sys,time,tomllib
from pathlib import Path

def settings():
    config=Path(os.environ.get('SIMPLEPICKER_CONFIG',str(Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'simplepicker/config.toml'))).expanduser()
    with config.open('rb') as f: values=tomllib.load(f).get('screensaver',{})
    enabled=values.get('enabled',True);seconds=values.get('idle_seconds',160)
    if type(enabled) is not bool or type(seconds) is not int or not 10<=seconds<=86400:
        raise ValueError('screensaver.enabled must be boolean; idle_seconds must be 10..86400')
    return enabled,seconds

def main():
    mode=sys.argv[1] if len(sys.argv)>1 else ''
    if mode not in ('','--restart','--stop','--check'):raise ValueError('Use --restart, --stop or --check')
    if mode=='--check':print(json.dumps(dict(zip(('enabled','idle_seconds'),settings()))));return
    runtime=Path(os.environ['XDG_RUNTIME_DIR'])
    lock=runtime/'simplepicker-idle.lock'
    with lock.open('a+') as handle:
        if mode in ('--restart','--stop'):
            handle.seek(0)
            try:
                pid=int(handle.read().strip())
                args=Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
                if str(Path(__file__).resolve()).encode() in args:os.kill(pid,signal.SIGTERM)
            except (ValueError,ProcessLookupError,FileNotFoundError):pass
            if mode=='--stop':return
        for attempt in range(40):
            try:fcntl.flock(handle,fcntl.LOCK_EX|fcntl.LOCK_NB);break
            except BlockingIOError:
                if mode!='--restart':return
                time.sleep(.1)
        else:raise RuntimeError('Existing idle watcher did not stop')
        handle.seek(0);handle.truncate();handle.write(str(os.getpid()));handle.flush()
        binary=os.environ.get('SIMPLEPICKER_BINARY','simplepicker')
        stop=False;child=None;active=None;last_error=None
        def halt(*_):
            nonlocal stop
            stop=True
        signal.signal(signal.SIGTERM,halt);signal.signal(signal.SIGINT,halt)
        def close_child():
            nonlocal child
            if child:
                child.terminate()
                try:child.wait(timeout=3)
                except subprocess.TimeoutExpired:child.kill();child.wait()
                child=None
            subprocess.run([binary,'--screensaver-stop'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5)
        try:
            while not stop:
                try:current=settings();last_error=None
                except (OSError,ValueError) as error:
                    if str(error)!=last_error:print(f'simplepicker idle: {error}',file=sys.stderr,flush=True);last_error=str(error)
                    if active is None:raise
                    current=active
                if current!=active:
                    if child:close_child()
                    enabled,seconds=current
                    if enabled:
                        child=subprocess.Popen(['swayidle','-w','timeout',str(seconds),shlex.join([binary,'--screensaver']),
                            'resume',shlex.join([binary,'--screensaver-stop'])])
                    active=current
                if child and child.poll() is not None:raise RuntimeError(f'swayidle exited with status {child.returncode}')
                time.sleep(.5)
        finally:
            close_child();handle.seek(0);handle.truncate()

if __name__=='__main__':
    try:main()
    except (OSError,ValueError,RuntimeError) as error:print(f'simplepicker idle: {error}',file=sys.stderr);sys.exit(1)
