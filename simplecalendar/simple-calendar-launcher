#!/bin/sh
# Locate code independently of the user's home or window manager.
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source=${SIMPLECALENDAR_SOURCE:-}
if [ -z "$source" ]; then
    for candidate in "$bindir/../share/simplecalendar" "${XDG_DATA_HOME:-$HOME/.local/share}/simplecalendar" "$bindir/../src/simplecalendar"; do
        if [ -f "$candidate/main.py" ]; then source=$candidate; break; fi
    done
fi
[ -n "$source" ] || { echo 'simple-calendar: application resources missing' >&2; exit 1; }
export SIMPLECALENDAR_SOURCE="$source"
case "${1-}" in
  --sync|--watch|--connect|--provider|--client-json|--calendar-id|--help|-h)
    runtime=${SIMPLE_CALENDAR_PYTHON:-${XDG_DATA_HOME:-$HOME/.local/share}/simple-calendar-runtime/bin/python}
    [ -x "$runtime" ] || runtime=python3
    exec "$runtime" "$source/main.py" "$@" ;;
  *) exec simplecalendar-native "$@" ;;
esac
