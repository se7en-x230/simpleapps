def signature(p):
    s=p.stat();return s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns

def read(p):
    before=signature(p)
    with Image.open(p) as im:
        if getattr(im,'n_frames',1)!=1:raise ValueError('Please choose a single still image.')
        if im.mode not in ('RGB','RGBA','L','LA'):raise ValueError('This trial supports ordinary RGB/grayscale JPEG, PNG and WebP images.')
        kind=im.format;im=ImageOps.exif_transpose(im);im.load()
        profile=im.info.get('icc_profile');exif=im.getexif().tobytes()
        im=im.convert('RGBA' if 'A' in im.mode else 'RGB')
        if profile:
            # Work and preview in sRGB so colour math has a defined colour space.
            target=ImageCms.createProfile('sRGB')
            im=ImageCms.profileToProfile(im,io.BytesIO(profile),target,outputMode=im.mode)
            profile=ImageCms.ImageCmsProfile(target).tobytes()
    if signature(p)!=before:raise ValueError('Image changed while loading.')
    small=im.copy();small.thumbnail((1200,800))
    a=np.asarray(small.convert('RGB'),dtype=np.float32)/255
    l=a@np.array([.2126,.7152,.0722],dtype=np.float32)
    # Dark scenes receive a limited lift; bright scenes receive almost none.
    lift=float(np.clip((.48-np.median(l))*1.4,0,.45))
    return im,small,lift,kind,before,profile,exif

CONTROLS=('Brightness','Contrast','Highlights','Shadows','Saturation','Vibrance','Warmth','Tint')

def enhance(im,settings):
    values={name:float(settings.get(name,0))/100 for name in CONTROLS}
    if not all(np.isfinite(v) and -1<=v<=1 for v in values.values()):raise ValueError('Adjustments must be between -100 and 100.')
    if not any(values.values()):return im.copy()
    out=im.copy()
    weights=np.array([.2126,.7152,.0722],dtype=np.float32)
    for y in range(0,im.height,128):
        box=(0,y,im.width,min(y+128,im.height));a=np.asarray(im.crop(box)).copy();rgb=a[:,:,:3].astype(np.float32)/255
        lum=rgb@weights
        # Smooth tone shifts taper at black and white; zero is the original.
        target=lum+values['Brightness']*.8*lum*(1-lum)
        target+=values['Shadows']*1.8*lum*(1-lum)**3
        target+=values['Highlights']*1.8*lum**3*(1-lum)
        target=np.clip(target,0,1)
        c=values['Contrast']
        if c>=0:
            power=1+1.5*c
            lo=target**power;hi=(1-target)**power
            target=lo/np.maximum(lo+hi,1e-6)
        else:target=.5+(target-.5)*(1+.7*c)
        # Luminance replacement preserves neutral tones and avoids division at black.
        rgb+= (target-lum)[:,:,None]
        rgb=np.clip(rgb,0,1)
        warmth=values['Warmth']*.12;tint=values['Tint']*.10
        mid=4*target*(1-target)
        rgb+=mid[:,:,None]*np.array([warmth+tint/2,-tint,-warmth+tint/2],dtype=np.float32)
        rgb=np.clip(rgb,0,1);gray=rgb@weights
        saturation=(rgb.max(axis=2)-rgb.min(axis=2))/np.maximum(rgb.max(axis=2),1e-6)
        factor=(1+values['Saturation'])*(1+values['Vibrance']*.65*(1-saturation))
        delta=(rgb-gray[:,:,None])*factor[:,:,None]
        bound=np.where(delta>0,(1-gray[:,:,None])/np.maximum(delta,1e-6),gray[:,:,None]/np.maximum(-delta,1e-6))
        limit=np.minimum(1,np.maximum(0,bound.min(axis=2)))
        rgb=gray[:,:,None]+delta*limit[:,:,None]
        a[:,:,:3]=np.rint(np.clip(rgb,0,1)*255).astype(np.uint8)
        out.paste(Image.fromarray(a),box)
    return out

def rotate_data(data,rect,mask,history,clockwise=True):
    im,small,lift,kind,before,profile,exif=data
    iw,ih=im.size;operation=Image.Transpose.ROTATE_270 if clockwise else Image.Transpose.ROTATE_90
    if rect:
        x,y,w,h=rect
        rect=(ih-y-h,x,h,w) if clockwise else (y,iw-x-w,h,w)
    metadata=Image.Exif();metadata.load(exif)
    for key in (256,257,274,40962,40963):
        if key in metadata:del metadata[key]
    rotated=(im.transpose(operation),small.transpose(operation),lift,kind,before,profile,metadata.tobytes())
    return rotated,rect,mask.transpose(operation) if mask is not None else None,[item.transpose(operation) for item in history]

def mirror_data(data,rect,mask,history,horizontal=True):
    im,small,lift,kind,before,profile,exif=data
    iw,ih=im.size;operation=Image.Transpose.FLIP_LEFT_RIGHT if horizontal else Image.Transpose.FLIP_TOP_BOTTOM
    if rect:
        x,y,w,h=rect;rect=(iw-x-w,y,w,h) if horizontal else (x,ih-y-h,w,h)
    metadata=Image.Exif();metadata.load(exif)
    if 274 in metadata:del metadata[274]
    mirrored=(im.transpose(operation),small.transpose(operation),lift,kind,before,profile,metadata.tobytes())
    return mirrored,rect,mask.transpose(operation) if mask is not None else None,[item.transpose(operation) for item in history]

def paint_mask(mask,start,end,radius,erase=False):
    """Paint a feathered stroke; white protects pixels, black selects blur."""
    radius=max(1,float(radius));pad=int(radius*1.6)+2
    x0=max(0,int(min(start[0],end[0]))-pad);y0=max(0,int(min(start[1],end[1]))-pad)
    x1=min(mask.width,int(max(start[0],end[0]))+pad+1);y1=min(mask.height,int(max(start[1],end[1]))+pad+1)
    if x1<=x0 or y1<=y0:return
    patch=Image.new('L',(x1-x0,y1-y0),0);draw=ImageDraw.Draw(patch)
    a=(start[0]-x0,start[1]-y0);b=(end[0]-x0,end[1]-y0)
    draw.line([a,b],fill=255,width=max(1,round(radius*2)))
    for x,y in (a,b):draw.ellipse((x-radius,y-radius,x+radius,y+radius),fill=255)
    patch=patch.filter(ImageFilter.GaussianBlur(max(.5,radius*.12)))
    old=mask.crop((x0,y0,x1,y1));paint=Image.new('L',patch.size,255 if erase else 0)
    mask.paste(Image.composite(paint,old,patch),(x0,y0))

def portrait_blur(im,mask,amount):
    if amount<=0:return im
    if mask is None:raise ValueError('Paint a blur selection first.')
    # Blur only background colours, reducing foreground colour bleeding at edges.
    small=im.convert('RGB');small.thumbnail((1600,1600))
    alpha=mask.resize(small.size,Image.Resampling.BILINEAR)
    weight=ImageOps.invert(alpha)
    radius=max(.5,min(small.size)*.035*amount/100)
    pixels=np.asarray(small,dtype=np.float32)
    weighted=Image.fromarray(np.rint(pixels*(np.asarray(weight,dtype=np.float32)/255)[:,:,None]).astype(np.uint8))
    numerator=np.asarray(weighted.filter(ImageFilter.GaussianBlur(radius)),dtype=np.float32)
    denominator=np.asarray(weight.filter(ImageFilter.GaussianBlur(radius)),dtype=np.float32)/255
    background=np.where((denominator>.01)[:,:,None],numerator/np.maximum(denominator[:,:,None],.01),pixels)
    background=Image.fromarray(np.rint(np.clip(background,0,255)).astype(np.uint8)).resize(im.size,Image.Resampling.BICUBIC)
    foreground=mask.resize(im.size,Image.Resampling.BILINEAR)
    result=Image.composite(im.convert('RGB'),background,foreground)
    if im.mode=='RGBA':result.putalpha(im.getchannel('A'))
    return result

def publish_copy(stage,target):
    try:
        os.link(stage,target)
        return
    except OSError as error:
        if error.errno not in (errno.EPERM,errno.EOPNOTSUPP,errno.EXDEV,errno.ENOSYS):
            raise
    # Cloud/FUSE mounts may support ordinary files but not hard links.
    # Exclusive creation retains the no-overwrite guarantee during numbering.
    with stage.open('rb') as source:
        output=target.open('xb')
        try:
            with output:
                shutil.copyfileobj(source,output)
        except BaseException:
            target.unlink(missing_ok=True)
            raise

def save(p,data,settings,rect=None,mask=None):
    im,small,lift,kind,before,profile,exif=data
    if signature(p)!=before:raise ValueError('Original changed; reopen it before saving.')
    if mask is not None:mask=mask.resize(im.size,Image.Resampling.BILINEAR)
    if rect:
        x,y,w,h=rect
        if min(x,y)<0 or min(w,h)<1 or x+w>im.width or y+h>im.height:raise ValueError('Invalid crop bounds')
        im=im.crop((x,y,x+w,y+h))
        if mask is not None:mask=mask.crop((x,y,x+w,y+h))
        metadata=Image.Exif();metadata.load(exif)
        for key in (256,257,40962,40963):
            if key in metadata:del metadata[key]
        exif=metadata.tobytes()
    result=portrait_blur(enhance(im,settings),mask,settings.get("Portrait blur",0))
    ext={'JPEG':'jpg','PNG':'png','WEBP':'webp'}.get(kind,'png')
    with tempfile.TemporaryDirectory(prefix='.enhance-',dir=p.parent) as folder:
        stage=Path(folder)/('copy.'+ext)
        kwargs={'icc_profile':profile,'exif':exif}
        if ext in ('jpg','webp'):kwargs['quality']=95
        result.save(stage,**kwargs)
        if signature(p)!=before:raise ValueError('Original changed while saving.')
        m=re.fullmatch(r'(.*)~([0-9]+)',p.stem);stem=m[1] if m else p.stem;n=max(1,int(m[2])+1) if m else 1
        while True:
            target=p.with_name(f'{stem}~{n}.{ext}')
            try:publish_copy(stage,target);return target
            except FileExistsError:n+=1

