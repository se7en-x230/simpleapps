            self.files=[];self.index=0;self.pixbuf=None;self.original_size=None;self.fit=True;self.zoom=1
            self.rotation=0;self.mirror=False;self.generation=0;self.collection=0;self.closed=False
            self.pool=ThreadPoolExecutor(max_workers=2,thread_name_prefix='simpleimage');self.loader=ThreadPoolExecutor(max_workers=1,thread_name_prefix='image-load')
            self.cache=Cache(cfg['cache_mb']*1024*1024);self.thumbcache=Cache(16*1024*1024)
            self.large_thumbnails=False;self.pending=None;self.show_grid=False;self.slide=0;self.full=False;self.prefix='';self.marked=set()

        def do_activate(self):
