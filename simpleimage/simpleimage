#!/usr/bin/env python3
"""Simpleimage — a small, keyboard-first GTK image viewer."""
import argparse
from collections import OrderedDict
from concurrent.futures import ThreadPoolExecutor
import json
import os
from pathlib import Path
import re
import subprocess
import threading
import sys
import tomllib

DEFAULTS=dict(window_width=1100,window_height=760,browse_folder=True,show_hidden=False,
              slideshow_seconds=5,cache_mb=128,max_dimension=8192,thumbnail_width=174,thumbnail_height=120,thumbnail_large_width=300,thumbnail_large_height=208,editor=['simplephoto'])


def settings(create=True):
    path=Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))/'simpleimage/config.toml'
    data=tomllib.loads(path.read_text()) if path.exists() else {}
    if data.keys()-DEFAULTS.keys():raise ValueError('Unknown Simpleimage setting')
    cfg=DEFAULTS|data
    for key,lo,hi in [('window_width',400,4000),('window_height',300,4000),('slideshow_seconds',1,3600),('cache_mb',16,512),('max_dimension',1024,16384),('thumbnail_width',80,600),('thumbnail_height',60,400),('thumbnail_large_width',80,1000),('thumbnail_large_height',60,800)]:
        if type(cfg[key]) is not int or not lo<=cfg[key]<=hi:raise ValueError('Invalid '+key)
    for key in ('browse_folder','show_hidden'):
        if type(cfg[key]) is not bool:raise ValueError(key+' must be boolean')
    if not isinstance(cfg['editor'],list) or not cfg['editor'] or any(not isinstance(x,str) or not x for x in cfg['editor']):raise ValueError('editor must be an argument list')
    if create and not path.exists():
        path.parent.mkdir(parents=True,exist_ok=True)
        with path.open('x') as f:
            f.write('# Portable Simpleimage settings; restart after editing.\n')
            for key,value in cfg.items():f.write(key+' = '+json.dumps(value)+'\n')
    return cfg


def natural(path):
    return tuple((1,int(part)) if part.isdigit() else (0,part.casefold()) for part in re.split(r'(\d+)',path.name))


def collect(paths,extensions,cfg):
    paths=[Path(p).expanduser().absolute() for p in paths]
    start=paths[0] if len(paths)==1 and paths[0].is_file() else None
    if start and cfg['browse_folder']:paths=[start.parent]
    found=[]
    for path in paths:
        if path.is_dir():
            found.extend(sorted((p for p in path.iterdir() if p.is_file() and p.suffix.lower().lstrip('.') in extensions and (cfg['show_hidden'] or not p.name.startswith('.'))),key=natural))
        elif path.is_file():found.append(path)
    if start and start not in found:found.append(start)
    found=list(dict.fromkeys(found))
    return found,found.index(start) if start in found else 0


class Cache:
    def __init__(self,limit):self.limit=limit;self.bytes=0;self.items=OrderedDict()
    def get(self,key):
        if key not in self.items:return None
        self.items.move_to_end(key);return self.items[key]
    def put(self,key,value):
        if key in self.items:self.bytes-=self.items.pop(key).get_byte_length()
        size=value.get_byte_length()
        if size>self.limit:return
        self.items[key]=value;self.bytes+=size
        while self.bytes>self.limit:self.bytes-=self.items.popitem(last=False)[1].get_byte_length()


def gui(cfg,args):
