            css=Gtk.CssProvider();css.load_from_data(b'window {background:#272625;color:#d8ceb0;} .title {color:#d99a00;font-weight:bold;} button {background:#35322e;color:#d8ceb0;} gridview {background:#272625;color:#d8ceb0;} gridview label {color:#d8ceb0;} gridview child:selected {background:#700909;}')
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_USER+1)
            box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=3);self.win.set_child(box)
            self.bar=Gtk.Box(spacing=6);self.bar.set_margin_start(8);self.bar.set_margin_end(8);box.append(self.bar)
            title=Gtk.Label(label='Simpleimage',xalign=0);title.add_css_class('title');self.bar.append(title)
            self.name=Gtk.Label(xalign=0,hexpand=True,ellipsize=3);self.bar.append(self.name)
            for text,fn in [('Open [o]',self.choose),('Edit [e]',self.edit),('Refresh [r]',self.refresh),('Print [Ctrl+p]',self.print_images)]:
                b=Gtk.Button(label=text);b.connect('clicked',lambda _,f=fn:f());self.bar.append(b)
            self.stack=Gtk.Stack(vexpand=True,hexpand=True);box.append(self.stack)
            self.scroll=Gtk.ScrolledWindow();self.picture=Gtk.Picture(can_shrink=True);self.picture.set_content_fit(Gtk.ContentFit.CONTAIN);self.scroll.set_child(self.picture);self.stack.add_named(self.scroll,'image')
