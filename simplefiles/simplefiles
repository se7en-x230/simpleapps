#!/usr/bin/env python3
"""Small GTK file chooser with Yazi-style navigation and portal compatibility."""
import argparse
import json
import os
from pathlib import Path
import sys
import stat
import threading
import shlex
import tomllib
from concurrent.futures import ThreadPoolExecutor
from types import SimpleNamespace


def initial_location(value, save=False):
    p = Path(value or Path.home()).expanduser().absolute()
    if p.is_dir():
        return p, ''
    name = p.name if save else ''
    parent = p.parent
    while not parent.is_dir() and parent != parent.parent:
        parent = parent.parent
    return parent, name


def chosen_paths(cwd, hovered, marked, directory=False, multiple=False):
    if directory:
        return [hovered if hovered is not None and hovered.is_dir() else cwd]
    candidates = list(marked) if multiple and marked else ([hovered] if hovered else [])
    if not candidates or any(not p.is_file() for p in candidates):
        raise ValueError('Choose a file.' if not directory else 'Choose a folder.')
    return candidates


def save_target(cwd, name):
    if not name.strip() or name in ('.', '..') or '/' in name or '\n' in name or '\r' in name:
        raise ValueError('Enter a filename without a slash or line break.')
    p = cwd / name
    if p.is_dir():
        raise ValueError('A folder already has that name.')
    return p


def write_result(paths, output=None):
    # termfilechooser uses one path per line and cannot represent newlines.
    if any('\n' in str(p) or '\r' in str(p) for p in paths):
        raise ValueError('The file chooser portal cannot return names containing line breaks.')
    result = ''.join(str(p.absolute()) + '\n' for p in paths)
    if output:
        Path(output).write_text(result)
    else:
        sys.stdout.write(result)


def bookmarks():
    home = Path.home()
    result = {'h': home, 'd': home/'Downloads', 'D': home/'Documents', 'm': home/'Music', '/': Path('/'), 'c': home/'.config'}
    config = Path(os.environ.get('XDG_CONFIG_HOME', home/'.config'))
    try:
        for line in (config/'user-dirs.dirs').read_text().splitlines():
            if '=' not in line or line.lstrip().startswith('#'): continue
            name, value = line.split('=', 1)
            key = {'XDG_DOWNLOAD_DIR':'d', 'XDG_DOCUMENTS_DIR':'D', 'XDG_MUSIC_DIR':'m'}.get(name.strip())
            if key:
                parts = shlex.split(value)
                if len(parts) == 1: result[key] = Path(parts[0].replace('$HOME', str(home))).expanduser()
    except (OSError, ValueError): pass
    try:
        yazi = tomllib.loads((config/'yazi/keymap.toml').read_text())
        for entry in yazi.get('mgr', {}).get('keymap', []):
            keys, run = entry.get('on'), entry.get('run')
            if not isinstance(keys, list) or len(keys) != 2 or keys[0] != 'g' or keys[1] == 'g' or not isinstance(run, str): continue
            parts = shlex.split(run)
            if len(parts) == 2 and parts[0] == 'cd' and not parts[1].startswith('-'):
                result[keys[1]] = Path(os.path.expandvars(parts[1])).expanduser()
    except (OSError, ValueError): pass
    try:
        overrides = json.loads((config/'simplefiles/config.json').read_text()).get('bookmarks', {})
        for key, path in overrides.items():
            if isinstance(key, str) and len(key) == 1 and key != 'g' and isinstance(path, str):
                result[key] = Path(os.path.expandvars(path)).expanduser()
    except (OSError, ValueError, AttributeError): pass
    return result


