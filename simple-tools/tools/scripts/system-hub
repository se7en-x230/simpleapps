#!/usr/bin/env python3
"""Configured System menu; Super+Shift+X starts in its Health section."""
import os as _path_os, sys as _path_sys
from pathlib import Path as _Path
_roots=[_Path(__file__).resolve().parents[3],_Path(_path_os.environ.get('XDG_DATA_HOME',_Path.home()/'.local/share')),_Path.home()/'.local/src']
if _path_os.environ.get('SIMPLE_SOURCE_ROOT'):_roots.insert(0,_Path(_path_os.environ['SIMPLE_SOURCE_ROOT']))
for _root in reversed(_roots):
    for _name in ('simplepicker/python','simple-common'):
        if (_root/_name).is_dir():_path_sys.path.insert(0,str(_root/_name))
import argparse
import os
from pathlib import Path
import runpy
import sys

HOME = Path.home()
from simplepicker_api import ToolMenu, notify


def health():
    module = runpy.run_path(str(Path(__file__).resolve().parents[2]/'health/scripts/desktop-health'))
    module['health_menu']()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--health', action='store_true', help='Start in the Health section')
    parser.add_argument('--config', type=Path, default=Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'simplepicker/tools/config.toml')
    parser.add_argument('--check-config', action='store_true', help='Validate tool entries without running them')
    args = parser.parse_args()
    tools = ToolMenu(args.config, handlers={'health': health})
    if args.check_config:
        print(f'{len(tools.tools)} tools configured in {args.config}')
        return
    os.environ['SIMPLEPICKER_VIM_MENU'] = '1'
    tools.run(start='health' if args.health else None)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    except (OSError, ValueError) as error:
        notify('System menu', str(error), error=True)
        sys.exit(1)
