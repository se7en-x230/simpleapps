#!/bin/sh
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for root in "${SIMPLE_TOOLS_SOURCE:-}" "$bindir/../share/simple-tools" "${XDG_DATA_HOME:-$HOME/.local/share}/simple-tools" "$bindir/../src/simple-tools"; do
    if [ -n "$root" ] && [ -f "$root/sound/scripts/panel.py" ]; then exec python3 "$root/sound/scripts/panel.py"  "$@"; fi
done
echo 'simple-sound: application resources missing' >&2
exit 1
