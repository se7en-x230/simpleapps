def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    modes=parser.add_mutually_exclusive_group();modes.add_argument('-f','--fullscreen',action='store_true');modes.add_argument('--region',action='store_true')
    parser.add_argument('--print-path',action='store_true',help='Save the capture and print its filename');parser.add_argument('--edit',action='store_true',help='Open Swappy for annotation');parser.add_argument('--record',action='store_true');parser.add_argument('--menu',action='store_true');parser.add_argument('--no-edit',action='store_true');parser.add_argument('--save',action='store_true');parser.add_argument('--no-copy',action='store_true');parser.add_argument('--delay',type=int);parser.add_argument('--check-config',action='store_true')
    parser.add_argument('--input',type=Path,help='Annotate an existing image with Swappy instead of capturing the screen')
    args=parser.parse_args(argv)
    try:
        if args.input and (args.region or args.fullscreen or args.record or args.menu):raise ValueError('--input cannot be combined with screen capture or recording modes')
        config=load_config()
        if args.input:config['edit']=True
        if args.check_config:print(config_path());return 0
        if args.fullscreen:config['mode']='fullscreen'
        if args.region:config['mode']='region'
        if args.no_edit and args.edit:raise ValueError('Choose --edit or --no-edit, not both')
        if args.no_edit:config['edit']=False
        if args.edit:config['edit']=True
        if args.print_path:config['save']=True
        if args.save:config['save']=True
        if args.no_copy:config['copy']=False
        if args.delay is not None:
            if not 0<=args.delay<=60:raise ValueError('delay must be between 0 and 60 seconds')
            config['delay_seconds']=args.delay
        if args.record:
            if args.fullscreen:config['record_mode']='fullscreen'
            elif args.region:config['record_mode']='region'
            if args.no_copy:config['record_copy']=False
            record(config)
        if not config['edit'] and not config['save'] and not config['copy']:raise ValueError('Enable copy or save when capturing without an editor')
        if args.menu:
            config=menu(config)
            if config is None:return 0
            if config.get('_record'):record(config)
        if not config['edit'] and not config['save'] and not config['copy']:raise ValueError('Quick capture needs copy or save enabled')
        saved=capture(config,args.input)
        if args.print_path and isinstance(saved,Path):print(saved)
        return 0
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as exc:
        print('Simplecapture: '+str(exc),file=sys.stderr)
        if 'config' in locals() and config:notify(config,'Screenshot failed',str(exc))
        return 1
if __name__=='__main__':raise SystemExit(main())
